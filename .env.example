# Copy to .env (local) and add the same variables in Vercel → Project → Settings → Environment Variables.

# Public cloud name. Needed at build time (locally and on Vercel) to serve images from Cloudinary.
# Leave empty to serve the files in public/ instead.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Only needed to run `npm run cloudinary:upload` (keep these secret; not needed on Vercel).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Cloudinary folder for this site's files (default "aksue").
CLOUDINARY_FOLDER=aksue
